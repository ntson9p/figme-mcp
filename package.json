{
  "name": "figfile-mcp",
  "version": "1.0.0",
  "private": false,
  "description": "MCP server that reads local Figma .fig files, fully offline",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "figfile-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && node --test",
    "test:fast": "node --test",
    "start": "node dist/mcp/server.js",
    "smoke": "node scripts/smoke.mjs",
    "crosscheck": "node --max-old-space-size=8192 scripts/crosscheck.mjs",
    "render": "node scripts/render.mjs",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "kiwi-schema": "^0.5.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  }
}
